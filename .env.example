# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAAA-your-bot-token
# Ваш chat id (узнать: напишите боту /start)
ADMIN_CHAT_ID=123456789
# Номер Kaspi, на который переводят деньги
KASPI_PHONE=+77470599188
# Цена полного доступа в тенге
PRICE=999
# Зачёркнутая «старая» цена на сайте (необязательно, 0 — не показывать)
OLD_PRICE=2999
# Адрес сайта без слэша в конце (для личных ссылок /access/<токен>)
SITE_URL=https://your-app.up.railway.app
# Папка для базы SQLite (на Railway — путь, куда смонтирован Volume, например /data)
DATA_DIR=./data
PORT=3000

# --- необязательные ---
# Контакт, который показывается, если платёж не найден (телефон, WhatsApp, @telegram)
SUPPORT_CONTACT=
# Сколько заявок можно создать с одного IP за 10 минут (по умолчанию 5)
ORDER_RATE_LIMIT=5
# Часовой пояс для времени в Telegram и /stats
TIME_ZONE=Asia/Almaty
# Название папки на сайте и ZIP-архива
FOLDER_TITLE=Семинар материалдары
